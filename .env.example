# Minimal Arkivra local development config.
# Values not set here use app defaults. Advanced overrides are documented in:
# apps/arkivra-docs/src/content/docs/self-hosting/configuration.md

# Process role for local development.
NODE_ENV=development
ARKIVRA_PROCESS_ROLE=web

# Public browser origin. In local development, the dashboard dev server proxies /api
# requests to the API process.
ARKIVRA_PUBLIC_URL=http://localhost:5173

# Local service endpoints.
ARKIVRA_DATABASE_URL=postgres://arkivra:arkivra@127.0.0.1:5432/arkivra
ARKIVRA_DOCLING_URL=http://127.0.0.1:5001

# Persistent runtime data root. Arkivra derives document storage, upload staging,
# and backups from this directory.
ARKIVRA_DATA_PATH=./var/default

# Required secrets. Generate strong, stable production values before storing
# important documents.
ARKIVRA_AUTH_SECRET=arkivra-dev-secret-change-in-production
# ARKIVRA_ENCRYPTION_KEYS=1:<generated-64-hex-character-key>

# Optional: fresh-instance restore before an admin account exists.
# ARKIVRA_RESTORE_BOOTSTRAP_TOKEN=<strong-random-token>

# Optional: production email delivery. Without SMTP, auth emails are printed to logs.
# ARKIVRA_SMTP_URL=smtp://user:password@smtp.example.com:587?starttls=true
# ARKIVRA_EMAIL_FROM=noreply@example.com
# ARKIVRA_EMAIL_FROM_NAME=Arkivra
# ARKIVRA_AUTH_EMAIL_VERIFICATION_REQUIRED=false

# Optional: close public registration after initial setup if you do not want open signup.
# ARKIVRA_AUTH_REGISTRATION_ENABLED=true

# Optional: Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: GitHub OAuth.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Gemini provider secret. AI features remain disabled until configured by
# an admin in Arkivra.
# GEMINI_API_KEY=

# Optional: Ollama-compatible provider endpoint for local chat, translation,
# and semantic indexing.
# ARKIVRA_OLLAMA_HOST=http://127.0.0.1:11434

# Optional: caption extracted document images during ingestion with a local
# Ollama vision-capable model. Disabled by default.
# ARKIVRA_OLLAMA_IMAGE_CAPTIONING_ENABLED=false
# ARKIVRA_OLLAMA_IMAGE_CAPTIONING_MODEL=granite4.1:3b

# Optional Privatemode provider: trusted local encryption proxy (API and worker).
# Never point this URL directly at api.privatemode.ai.
# For pnpm development, point to a running local Privatemode encryption proxy.
# ARKIVRA_PRIVATEMODE_PROXY_URL=http://127.0.0.1:8080/v1
# For same-host isolated container networks only; remote proxies must use HTTPS.
# ARKIVRA_PRIVATEMODE_ALLOW_PRIVATE_HTTP=false
# PRIVATEMODE_API_KEY=
# Optional scoped prompt caching: generate once with openssl rand -hex 32.
# Use the same secret on API and worker; keep it private and stable across restarts.
# ARKIVRA_PRIVATEMODE_CACHE_SECRET=
# Optional production overlay: compose.privatemode.yaml
# PRIVATEMODE_PROXY_IMAGE=ghcr.io/edgelesssys/privatemode/privatemode-proxy@sha256:<digest>

# Remote ingestion experiment: all supported source types are parsed/chunked by Privatemode.
# Office conversion and PDF rendering prepare inputs without local model inference.
# ARKIVRA_INGESTION_ENGINE=privatemode
# ARKIVRA_PRIVATEMODE_PROXY_URL=http://127.0.0.1:8080/v1
# PRIVATEMODE_API_KEY=
# ARKIVRA_REMOTE_STRUCTURE_MODEL=gpt-oss-120b
# ARKIVRA_REMOTE_MAX_CHUNK_CHARACTERS=3200
# ARKIVRA_REMOTE_PARSING_TIMEOUT_MS=1800000
# ARKIVRA_GOTENBERG_URL=http://127.0.0.1:3001
