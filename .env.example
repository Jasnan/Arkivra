# Minimal Arkivra local development config.
# The API loads this file from the repository root. Values not set here use app defaults.
# Advanced and production-oriented settings are documented in docs/configuration.md.

# Node runtime environment. Use development locally; production deployments should set production.
NODE_ENV=development

# API process role. Local package scripts override this for dev:web, dev:worker, and dev:all.
# Valid values are web, worker, and all.
PROCESS_MODE=web

# Optional local instance name for secondary worktrees. When set, default storage,
# upload staging, and backups move under ./var/<APP_INSTANCE>/ relative to the API process.
# APP_INSTANCE=ui-chat

# API listen port used by the Hono server and local URL derivation.
ARKIVRA_PORT=1221

# Vite dashboard development server port used by pnpm dev:web.
ARKIVRA_WEB_PORT=5173

# Optional public API origin. Omit locally unless the API is behind a custom host or proxy.
# ARKIVRA_SERVER_BASE_URL=http://localhost:1221

# Optional comma-separated dashboard origins allowed to call the API.
# ARKIVRA_CORS_ORIGINS=http://localhost:5173

# Optional public dashboard origin used for auth redirects.
# ARKIVRA_WEB_BASE_URL=http://localhost:5173

# Optional trusted origins for Better Auth CSRF protection. Defaults to the local API
# and web origins.
# ARKIVRA_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:1221

# Optional public Better Auth/API base URL. Required when OAuth callbacks use a custom
# external origin.
# BETTER_AUTH_URL=http://localhost:1221

# PostgreSQL connection URL used by the API, workers, migrations, and database checks.
ARKIVRA_DATABASE_URL=postgres://arkivra:arkivra@127.0.0.1:5432/arkivra

# Host port published by docker-compose for the local PostgreSQL service.
ARKIVRA_POSTGRES_PORT=5432

# Docling Serve HTTP API URL used by document processing workers.
ARKIVRA_DOCLING_URL=http://127.0.0.1:5001

# Host port published by docker-compose for the local Docling service.
ARKIVRA_DOCLING_PORT=5001

# Optional. Keep all files on the default Docling pipeline unless an approved Docling VLM
# runtime is available. When enabled, only scan-heavy PDFs and image files use VLM.
# ARKIVRA_DOCLING_VLM_PIPELINE=disabled

# Optional. Only valid when ARKIVRA_DOCLING_VLM_PIPELINE=enabled. If omitted, Docling
# Serve uses its default VLM preset.
# ARKIVRA_DOCLING_VLM_MODEL=glm_ocr

# Optional explicit local paths. If omitted and APP_INSTANCE is set, Arkivra uses
# ./var/<APP_INSTANCE>/document-storage, upload-staging, and backups.
# ARKIVRA_STORAGE_FS_PATH=./document-storage
# ARKIVRA_UPLOAD_STAGING_PATH=./upload-staging
# ARKIVRA_BACKUPS_PATH=./backups
# Required for encrypted backup archives. Generate with: openssl rand -hex 32
# ARKIVRA_BACKUP_ENCRYPTION_KEY=<generated-64-hex-character-key>
# Optional first-run restore token. Required to use /restore before an admin exists.
# ARKIVRA_RESTORE_BOOTSTRAP_TOKEN=<strong-random-token>
# Optional encrypted backup part size. Default is 16 GiB.
# ARKIVRA_BACKUP_PART_SIZE_BYTES=17179869184

# Example secondary worktree convention:
# APP_INSTANCE=rag
# ARKIVRA_WEB_PORT=5174
# ARKIVRA_PORT=1222
# ARKIVRA_DATABASE_URL=postgres://arkivra:arkivra@127.0.0.1:5432/arkivra_rag

# Better Auth session secret. Generate a strong, stable value for production.
ARKIVRA_AUTH_SECRET=arkivra-dev-secret-change-in-production

# Whether open registration is enabled. Disable in production after bootstrap if
# invitations are required.
# ARKIVRA_AUTH_REGISTRATION_ENABLED=true

# Require signup email verification. Production deployments that enable this must configure SMTP.
ARKIVRA_AUTH_EMAIL_VERIFICATION_REQUIRED=false

# Auth email delivery backend. Local development prints auth emails to the API log.
ARKIVRA_EMAIL_DELIVERY=console

# Sender address used for auth emails.
ARKIVRA_EMAIL_FROM=noreply@localhost

# Sender display name used for auth emails.
ARKIVRA_EMAIL_FROM_NAME=Arkivra

# SMTP delivery settings. Required when ARKIVRA_EMAIL_DELIVERY=smtp.
# ARKIVRA_EMAIL_DELIVERY=smtp
# ARKIVRA_EMAIL_FROM=noreply@example.com
# ARKIVRA_SMTP_HOST=smtp.example.com
# ARKIVRA_SMTP_PORT=587
# ARKIVRA_SMTP_SECURE=false
# ARKIVRA_SMTP_STARTTLS=true
# ARKIVRA_SMTP_USER=
# ARKIVRA_SMTP_PASSWORD=

# Optional Google OAuth provider. Empty client values disable the provider.
# Authorized redirect URI for this local config:
# http://localhost:1221/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:1221/api/auth/callback/google

# Optional GitHub OAuth provider. Empty client values disable the provider.
# Authorization callback URL for this local config:
# http://localhost:1221/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:1221/api/auth/callback/github

# Required envelope-encryption KEK list for uploaded originals and extracted assets.
# Generate a key with: openssl rand -hex 32
# Format: version:64-hex-key, for example 1:<generated-key>
# ARKIVRA_ENCRYPTION_KEYS=1:<generated-64-hex-character-key>

# Post-parse text cleanup strategy. Use deterministic for formatting-only normalization, or none.
ARKIVRA_PARSER_TEXT_CLEANUP=deterministic

# Number of documents a worker may process in parallel. Keep at 1 for the default Docling container.
ARKIVRA_DOCUMENT_PROCESSING_CONCURRENCY=1

# Optional local Ollama-compatible defaults for AI settings. AI features remain disabled
# until enabled from admin AI settings; keyword search and document ingestion do not
# require these values.
# ARKIVRA_OLLAMA_HOST=http://127.0.0.1:11434
# ARKIVRA_OLLAMA_MODEL=gemma4:e4b
# ARKIVRA_OLLAMA_EMBEDDING_BATCH_SIZE=20
# ARKIVRA_OLLAMA_LOG_REQUESTS=false

# Optional default secret ref for the Google Gemini provider. Required only when Gemini is enabled
# and provider settings reference GEMINI_API_KEY.
# GEMINI_API_KEY=
