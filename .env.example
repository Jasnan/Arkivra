# Minimal Arkivra local development config.
# Everything not listed here falls back to a sensible app default.

NODE_ENV=development
PROCESS_MODE=web

ARKIVRA_PORT=1221
ARKIVRA_SERVER_BASE_URL=http://localhost:1221
ARKIVRA_CORS_ORIGINS=http://localhost:5173
ARKIVRA_WEB_BASE_URL=http://localhost:5173
BETTER_AUTH_URL=http://localhost:1221

ARKIVRA_DATABASE_URL=postgres://arkivra:arkivra@127.0.0.1:5432/arkivra
ARKIVRA_DOCLING_URL=http://127.0.0.1:5001

ARKIVRA_AUTH_SECRET=arkivra-dev-secret-change-in-production
ARKIVRA_AUTH_EMAIL_VERIFICATION_REQUIRED=true

# Local development prints auth emails to the API log.
# Production should use SMTP and real sender credentials.
ARKIVRA_EMAIL_DELIVERY=console
ARKIVRA_EMAIL_FROM=noreply@localhost
ARKIVRA_EMAIL_FROM_NAME=Arkivra
# ARKIVRA_EMAIL_DELIVERY=smtp
# ARKIVRA_EMAIL_FROM=noreply@example.com
# ARKIVRA_SMTP_HOST=smtp.example.com
# ARKIVRA_SMTP_PORT=587
# ARKIVRA_SMTP_SECURE=false
# ARKIVRA_SMTP_STARTTLS=true
# ARKIVRA_SMTP_USER=
# ARKIVRA_SMTP_PASSWORD=

# OAuth providers (optional — leave empty to disable)
# Google: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for this local config:
# http://localhost:1221/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:1221/api/auth/callback/google
# GitHub: https://github.com/settings/developers
# Authorization callback URL for this local config:
# http://localhost:1221/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:1221/api/auth/callback/github

# Generate with: openssl rand -hex 32
ARKIVRA_ENCRYPTION_KEYS=

ARKIVRA_PARSER_GLUED_WORD_NORMALIZATION=ollama
ARKIVRA_AI_NORMALIZATION_MAX_INPUT_CHARS=1000
ARKIVRA_DOCUMENT_PROCESSING_CONCURRENCY=1

ARKIVRA_OLLAMA_HOST=http://127.0.0.1:11434
ARKIVRA_OLLAMA_MODEL=gemma4:e4b
ARKIVRA_OLLAMA_EMBEDDING_BATCH_SIZE=20
ARKIVRA_OLLAMA_LOG_REQUESTS=false
