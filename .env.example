# ============================================================
# Arkivra — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# All variables prefixed with ARKIVRA_ are application-specific.

# ------------------------------------------------------------
# General
# ------------------------------------------------------------
NODE_ENV=development
PROCESS_MODE=all                    # 'all' | 'web' | 'worker'

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
ARKIVRA_PORT=1221
ARKIVRA_HOSTNAME=0.0.0.0
ARKIVRA_SERVER_BASE_URL=http://localhost:1221
ARKIVRA_CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------
ARKIVRA_DATABASE_URL=postgres://arkivra:arkivra@localhost:5432/arkivra

# ------------------------------------------------------------
# Redis (BullMQ)
# ------------------------------------------------------------
ARKIVRA_REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Parsing pipeline
# ------------------------------------------------------------
# Default parser engine used when a document does not specify one.
ARKIVRA_PARSER_DEFAULT=docling
# Post-parse text cleanup. `deterministic` applies safe formatting-only rules
# (NFKC, ligature fix, hyphen-linebreak join, whitespace normalization).
# Set to `none` to store raw engine output unchanged.
ARKIVRA_PARSER_TEXT_CLEANUP=deterministic

# ------------------------------------------------------------
# Docling (document extraction)
# ------------------------------------------------------------
ARKIVRA_DOCLING_URL=http://localhost:5001
# Request markdown output — preserves word boundaries better than plain text
# on scanned PDFs. Accepted: `md`, `text`, or a comma-separated list.
ARKIVRA_DOCLING_OUTPUT_FORMAT=md
ARKIVRA_DOCLING_DO_OCR=true
# `easyocr` (default) or `tesseract`. Try tesseract if scans produce merged
# tokens like "GOVERNMENTOFKERALA" — it often preserves word boundaries better.
ARKIVRA_DOCLING_OCR_ENGINE=easyocr
ARKIVRA_DOCLING_TABLE_MODE=fast
ARKIVRA_DOCLING_ABORT_ON_ERROR=false
# Version label recorded on parsed documents for provenance.
ARKIVRA_DOCLING_ENGINE_VERSION=v1

# ------------------------------------------------------------
# Authentication (Better Auth)
# ------------------------------------------------------------
# IMPORTANT: Change this in production! Must be a strong random string.
ARKIVRA_AUTH_SECRET=arkivra-dev-secret-change-in-production

# ------------------------------------------------------------
# Encryption at Rest (AES-256-GCM envelope encryption)
# ------------------------------------------------------------
# Format: "version:hex-key" — e.g., "1:abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789"
# For key rotation, comma-separate: "1:oldkey,2:newkey" (highest version encrypts new files)
# Generate a 32-byte hex key: openssl rand -hex 32
# WARNING: Losing this key = permanent loss of access to encrypted documents.
ARKIVRA_ENCRYPTION_KEYS=

# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------
ARKIVRA_STORAGE_DRIVER=filesystem   # 'filesystem' | 's3'
ARKIVRA_STORAGE_FS_PATH=./document-storage

# Enable the Ollama-based OCR whitespace/glued-word normalizer
ARKIVRA_PARSER_GLUED_WORD_NORMALIZATION=ollama

# Make sure post-parse cleanup is on (recommended; deterministic runs before Ollama)
ARKIVRA_PARSER_TEXT_CLEANUP=deterministic

# Ollama server + model
ARKIVRA_OLLAMA_HOST=http://127.0.0.1:11434
ARKIVRA_OLLAMA_MODEL=gemma4:e2b

# Min length of an alphabetic run before a line is considered "suspicious"
# int between 4 and 128, default 12
ARKIVRA_OLLAMA_GLUED_WORD_MIN_TOKEN_LENGTH=12

# Max number of candidate lines sent to Ollama per document
# int between 1 and 1000, default 100
ARKIVRA_OLLAMA_GLUED_WORD_MAX_CANDIDATES=100

# Number of candidate lines grouped into each Ollama request
# int between 1 and 200, default 10
ARKIVRA_OLLAMA_GLUED_WORD_BATCH_SIZE=10

# Logs every Ollama normalization request/response (prompt + raw model output)
# boolean: "true" / "false" (also accepts "1" / "0"), default false
ARKIVRA_OLLAMA_LOG_REQUESTS=true
