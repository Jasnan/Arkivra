#!/bin/sh

# Git lists every ref being pushed on stdin. Block only updates to the remote main branch so
# release tags can still be pushed while main is checked out.
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct push to main is blocked locally."
    echo "Create a branch and push that instead:"
    echo "  git checkout -b fix/your-change"
    echo "  git push -u origin fix/your-change"
    exit 1
  fi
done

exit 0
