{
  "name": "@arkivra/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Arkivra API server",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "dev:web": "PROCESS_MODE=web tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "dev:worker": "PROCESS_MODE=worker tsx watch --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "build": "esbuild --bundle src/index.ts --platform=node --packages=external --format=esm --outfile=dist/index.js --minify",
    "start": "node dist/index.js",
    "start:with-migrations": "pnpm db:migrate && pnpm start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "pnpm run test:non-e2e && pnpm run test:e2e:all",
    "test:non-e2e": "vitest run --exclude \"src/**/*.e2e.integration.test.ts\"",
    "test:e2e:backups": "vitest run src/modules/admin/backups/backups.e2e.integration.test.ts",
    "test:e2e:all": "pnpm run test:e2e:migrations && pnpm run test:e2e:persistence && pnpm run test:e2e:authorization && pnpm run test:e2e:processing && pnpm run test:e2e:backups && pnpm run test:e2e:background-jobs",
    "test:e2e:authorization": "vitest run src/modules/authorization/authorization.e2e.integration.test.ts",
    "test:e2e:background-jobs": "vitest run src/modules/worker/background-jobs.e2e.integration.test.ts",
    "test:e2e:migrations": "vitest run src/modules/database/migrations.e2e.integration.test.ts",
    "test:e2e:persistence": "vitest run src/modules/parsing/persistence.e2e.integration.test.ts",
    "test:e2e:processing": "vitest run src/modules/documents/documents.e2e.integration.test.ts src/modules/documents/docling-fixture.e2e.integration.test.ts",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@napi-rs/canvas": "^0.1.100",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.4.6",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.41.0",
    "figue": "^3.2.0",
    "hono": "^4.10.7",
    "ollama": "^0.6.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.16.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
