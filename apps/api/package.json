{
  "name": "@arkivra/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Arkivra API server",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild --bundle src/index.ts --platform=node --packages=external --format=esm --outfile=dist/index.js --minify",
    "start": "node dist/index.js",
    "start:with-migrations": "pnpm db:migrate && pnpm start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-auth": "^1.4.6",
    "bullmq": "^5.34.8",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.41.0",
    "figue": "^3.2.0",
    "hono": "^4.10.7",
    "ioredis": "^5.6.1",
    "pg": "^8.16.0",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
