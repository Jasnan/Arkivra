# Environment Variables for the parallel Arkivra shadcn client

# Local ports for this migration worktree. These defaults intentionally avoid the
# existing Arkivra client defaults of web 5173 and API 1221.
ARKIVRA_WEB_NEW_PORT=5174
ARKIVRA_WEB_NEW_PREVIEW_PORT=4174
ARKIVRA_CLIENT_NEW_API_PORT=1321

# Optional explicit API target for Vite's /api dev proxy.
# Defaults to http://127.0.0.1:${ARKIVRA_CLIENT_NEW_API_PORT}.
VITE_ARKIVRA_API_BASE_URL=http://127.0.0.1:1321

# Matching backend environment for an exclusive local API instance:
#
#   ARKIVRA_APP_INSTANCE=arkivra-client-new-shadcn \
#   ARKIVRA_PROCESS_ROLE=all \
#   ARKIVRA_PORT=1321 \
#   ARKIVRA_WEB_PORT=5174 \
#   ARKIVRA_PUBLIC_URL=http://localhost:5174 \
#   pnpm --dir apps/arkivra-server dev
#
# ARKIVRA_APP_INSTANCE namespaces worktree runtime state such as queues and
# derived data paths. Use a separate ARKIVRA_DATABASE_URL too if you need a
# fully separate local database.

# Google Tag Manager ID (optional)
# Only set this in production deployments to enable analytics tracking
# Leave empty or omit for development/open-source usage
VITE_GTM_ID=

# Example for your production deployment:
# VITE_GTM_ID=GTM-XXXXXXXX

# Base path for deployment (optional)
# Used when deploying to a subdirectory.
VITE_BASENAME=
