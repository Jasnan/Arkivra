{
	"name": "@arkivra/website",
	"type": "module",
	"version": "0.1.0",
	"description": "Marketing website for Arkivra, an open-source self-hostable document management system.",
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=9"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "astro check",
		"lint": "biome check .",
		"lint:fix": "biome check --apply-unsafe .",
		"test": "pnpm run test:fast",
		"test:fast": "pnpm run check"
	},
	"dependencies": {
		"@lucide/astro": "^1.17.0",
		"@tailwindcss/vite": "^4.1.14",
		"tailwindcss": "^4.1.14"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "1.7.3",
		"astro": "^6.4.2",
		"typescript": "^5.4.5"
	}
}
