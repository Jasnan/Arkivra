---
import { buildLocalizedPath, useI18n } from '../i18n/i18n';
import { GITHUB_REPO_URL } from '../socials';
import { cn } from '../utils/cn';

const { t } = useI18n({ locale: Astro.currentLocale });
const DOCS_URL = 'https://docs.arkivra.app';

const sections: {
  title: string;
  links: { label: string; url?: string; target?: string; rel?: string; isAvailable?: boolean }[];
}[] = [
  {
    title: t('footer.section.product'),
    links: [
      {
        label: t('nav.features'),
        url: '/#features',
      },
      {
        label: t('footer.link.security'),
        url: '/#security',
      },
      {
        label: t('footer.link.documentation'),
        url: DOCS_URL,
        target: '_blank',
        rel: 'noopener',
      },
    ],
  },
  {
    title: t('footer.section.open-source'),
    links: [
      {
        label: t('footer.link.repository'),
        url: GITHUB_REPO_URL,
        target: '_blank',
        rel: 'noopener',
      },
      {
        label: t('footer.link.license'),
        url: `${GITHUB_REPO_URL}/blob/main/LICENSE`,
        target: '_blank',
        rel: 'noopener',
      },
    ],
  },
  {
    title: t('footer.section.legal'),
    links: [
      {
        label: t('footer.link.contact'),
        url: buildLocalizedPath({ locale: Astro.currentLocale, path: '/contact' }),
      },
      {
        label: t('footer.link.privacy-policy'),
        url: '/privacy',
      },
      {
        label: t('footer.link.terms-of-service'),
        url: '/terms-of-service',
      },
    ],
  },
];
---

<footer class="bg-card border-t border-border py-10 text-base text-muted-foreground">
  <div class="max-w-1200px mx-auto p-4">
    <div class="flex justify-between flex-col md:flex-row gap-10">
      <div class="">
        <a href={buildLocalizedPath({ locale: Astro.currentLocale, path: '/' })} class="text-xl font-bold flex items-center group mb-2">
          <span class="flex size-9 items-center justify-center rounded-md border border-[hsl(45_10%_88%)] bg-[hsl(60_14%_97.2%)] p-1 shadow-sm" aria-hidden="true">
            <img src="/arkivra-sidebar-logo.svg" alt="" class="size-full object-contain" loading="lazy" decoding="async" />
          </span>
          <span class="ml-2 text-foreground group-hover:text-foreground/80 transition">Arkivra</span>
        </a>

        <p class="mt-5 max-w-280px leading-7" set:html={t('footer.made-in-europe')} />

      </div>

      <div class={cn('grid gap-6 grid-cols-1', `sm:grid-cols-${sections.length}`)}>
        {
          sections.map(section => (
            <div>
              <div class="text-sm font-semibold uppercase tracking-wide text-foreground">{section.title}</div>
              <div class="mt-3">
                {section.links.map(link => (
                  link.isAvailable === false
                    ? (
                      <span class="block cursor-default py-1 leading-7 text-muted-foreground/70" aria-disabled="true">
                        {link.label}
                      </span>
                      )
                    : (
                      <a href={link.url} class="block py-1 leading-7 transition hover:text-primary" target={link.target} rel={link.rel}>
                        {link.label}
                      </a>
                      )
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-10 border-t border-border pt-5 leading-7" set:html={t('footer.copyright', { year: new Date().getFullYear() })} />
  </div>
</footer>
