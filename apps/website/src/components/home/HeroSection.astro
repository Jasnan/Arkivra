---
import AnimatedText from "@/components/ui/AnimatedText.astro";
import Badge from "@/components/ui/Badge.astro";
import BrowserFrame from "@/components/ui/BrowserFrame.astro";
import Button from "@/components/ui/Button.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Vault } from "@lucide/astro";

const selfHostingGuideUrl =
	"https://docs.arkivra.app/self-hosting/using-docker-compose/";

const vaults = [
	{
		title: "IDs & Passports",
		description: "Passports, national IDs, visas",
		files: "31 files",
		size: "23.3 MB",
	},
	{
		title: "Insurance",
		description: "Health, home, car, travel policies",
		files: "186 files",
		size: "558.0 MB",
	},
	{
		title: "Vehicles",
		description: "Registration, service, manuals",
		files: "161 files",
		size: "724.5 MB",
	},
	{
		title: "Travel",
		description: "Trip plans, bookings, tickets",
		files: "216 files",
		size: "729.0 MB",
	},
	{
		title: "Home Inventory",
		description: "Valuables, warranties, serial numbers",
		files: "56 files",
		size: "63.0 MB",
	},
	{
		title: "Kids & School",
		description: "Reports, certificates, activities",
		files: "78 files",
		size: "321.8 MB",
	},
	{
		title: "Health",
		description: "Medical records and reports",
		files: "67 files",
		size: "100.5 MB",
	},
	{
		title: "Work",
		description: "Work related documents",
		files: "71 files",
		size: "319.5 MB",
	},
	{
		title: "Finance",
		description: "Financial records and statements",
		files: "52 files",
		size: "195.0 MB",
	},
];
---

<div class="relative site-container z-20 w-full mx-auto mt-16 px-4 md:mt-18 lg:mt-32 xl:px-0">
  <div class="relative w-full px-4 flex flex-col items-center justify-between md:flex-row mb-16">
    <!-- Left: Text -->
    <div class="relative w-full md:max-w-[520px] md:w-1/2 text-center sm:text-left sm:-mt-8">
      <!-- Badges -->
      <div
        class="flex flex-wrap gap-2 justify-center sm:justify-start mb-6"
        data-aos="fade-up-xs"
        data-aos-delay="100"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Badge variant="primary">Open-source</Badge>
        <Badge variant="accent">Self-hostable</Badge>
      </div>

      <!-- Title -->
      <h1 class="mb-4">
        <AnimatedText
          content="Your documents, finally under control."
          delay={0.1}
          duration={0.5}
          stagger={0.08}
          class="text-4xl text-pri leading-tight md:text-4xl lg:text-6xl font-brand"
        />
      </h1>

      <!-- Subtitle -->
      <div class="mb-6">
        <AnimatedText
          content="Store, organize, and search everything from personal records to work documents. Self-host Arkivra and turn scattered files into information you can actually use."
          delay={0.3}
          duration={0.5}
          stagger={0.015}
          class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed"
        />
      </div>

      <!-- Buttons -->
      <div
        class="flex flex-wrap gap-3 justify-center sm:justify-start"
        data-aos="fade-up-sm"
        data-aos-delay="600"
        data-aos-duration="500"
        data-aos-once="true"
      >
        <Button url={selfHostingGuideUrl} type="fill" target="_blank">

          Self-host Arkivra <ArrowRight size={16} />
        </Button>
        <Button url={siteConfig.social.github} target="_blank">
          View on GitHub <ArrowRight size={16} />
        </Button>
      </div>
    </div>

    <!-- Right: Product Preview -->
    <div
      class="relative justify-end w-full mt-16 md:flex md:pl-10 md:w-1/2 md:mt-0 md:translate-y-4 xl:translate-y-0"
      data-aos="fade-left-sm"
      data-aos-delay="300"
      data-aos-duration="800"
      data-aos-once="true"
    >
      <BrowserFrame url="arkivra.app" className="w-full">
        <div class="relative h-[320px] overflow-hidden bg-white p-3 md:h-[380px] md:p-4 dark:bg-[#0b1220]">
          <div class="grid h-full grid-cols-3 gap-2 md:gap-3">
            {vaults.map((vault) => (
              <article class="flex min-h-0 flex-col items-center justify-center rounded-lg border border-primary/10 bg-bg-primary/40 px-2.5 py-2.5 text-center dark:border-neutral-700 dark:bg-neutral-800/40 md:rounded-xl md:px-3 md:py-3">
                <Vault class="mb-1.5 h-5 w-5 flex-shrink-0 text-neutral-700 dark:text-neutral-200 md:h-6 md:w-6" stroke-width={1.8} />
                <h3 class="w-full text-[11px] font-semibold leading-tight text-primary dark:text-primary-light md:text-[13px]">
                  {vault.title}
                </h3>
                <p class="mt-1 hidden w-full truncate text-[9px] leading-tight text-neutral-500 dark:text-neutral-400 sm:block md:text-[10px]">
                  {vault.description}
                </p>
                <p class="mt-1.5 truncate text-[9px] leading-none text-neutral-500 dark:text-neutral-400 md:mt-2 md:text-[11px]">
                  {vault.files} · {vault.size}
                </p>
              </article>
            ))}
          </div>
        </div>
      </BrowserFrame>
    </div>
  </div>
</div>
