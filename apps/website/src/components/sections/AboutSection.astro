---
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import Image3D from "@/components/ui/Image3D.astro";
import {
	aiFlexibilityNote,
	docsUrl,
	documentFeatures,
	optionalAiFeatures,
	retrievalFeatures,
} from "@/data/landing";
import { ArrowRight } from "@lucide/astro";
---

<section id="features" class="py-24 sm:py-32">
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<div class="mx-auto mb-16 max-w-3xl text-center">
			<Badge variant="outline" class="mb-4">Features</Badge>
			<h2 class="mb-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
				Built for organizing and finding documents.
			</h2>
			<p class="text-xl leading-8 text-muted-foreground text-pretty">
				Practical tools for storing documents, finding information, and understanding what is inside your archive.
			</p>
		</div>

		<div class="mb-24 grid items-center gap-12 lg:grid-cols-2 lg:gap-8 xl:gap-16">
			<Image3D
				lightSrc="/images/vaults_screenshot_list_light.png"
				darkSrc="/images/vaults_screenshot_list_dark.png"
				alt="Arkivra vault list workspace"
				direction="right"
				fit="contain"
				fade={false}
			/>

			<div class="space-y-6">
				<div class="space-y-4">
					<h3 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
						Organize documents around real collections
					</h3>
					<p class="text-lg leading-8 text-muted-foreground text-pretty">
						Arkivra is built around vaults, folders, tags, versions, and permissions, so your archive stays structured
						as it grows.
					</p>
				</div>

				<ul class="grid gap-4 sm:grid-cols-2">
					{
						documentFeatures.map((feature) => {
							const Icon = feature.icon;

							return (
								<li class="flex items-start gap-3 rounded-lg p-2 transition-colors hover:bg-accent/5">
									<Icon class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
									<div>
										<h4 class="text-lg font-medium text-foreground">{feature.title}</h4>
										<p class="mt-1 text-base leading-7 text-muted-foreground">{feature.description}</p>
									</div>
								</li>
							);
						})
					}
				</ul>
			</div>
		</div>

		<div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-8 xl:gap-16">
			<div class="order-2 space-y-6 lg:order-1">
				<div class="space-y-4">
					<h3 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
						Find information across your documents
					</h3>
					<p class="text-lg leading-8 text-muted-foreground text-pretty">
						Arkivra helps you search, retrieve, and understand what is inside your archive — with full-text search by
						default and optional AI when enabled.
					</p>
				</div>

				<div class="grid gap-8 sm:grid-cols-2">
					<div>
						<div class="mb-4">
							<h4 class="text-xl font-semibold text-foreground">Search & retrieval</h4>
							<p class="mt-1 text-base text-muted-foreground">Works without AI.</p>
						</div>
						<ul class="grid gap-4">
							{
								retrievalFeatures.map((feature) => {
									const Icon = feature.icon;

									return (
										<li class="flex items-start gap-3 rounded-lg p-2 transition-colors hover:bg-accent/5">
											<Icon class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
											<div>
												<h5 class="text-lg font-medium text-foreground">{feature.title}</h5>
												<p class="mt-1 text-base leading-7 text-muted-foreground">{feature.description}</p>
											</div>
										</li>
									);
								})
							}
						</ul>
					</div>

					<div>
						<div class="mb-4">
							<h4 class="text-xl font-semibold text-foreground">Optional AI</h4>
							<p class="mt-1 text-base text-muted-foreground">Works when enabled.</p>
						</div>
						<ul class="grid gap-4">
							{
								optionalAiFeatures.map((feature) => {
									const Icon = feature.icon;

									return (
										<li class="flex items-start gap-3 rounded-lg p-2 transition-colors hover:bg-accent/5">
											<Icon class="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
											<div>
												<h5 class="text-lg font-medium text-foreground">{feature.title}</h5>
												<p class="mt-1 text-base leading-7 text-muted-foreground">{feature.description}</p>
											</div>
										</li>
									);
								})
							}
						</ul>
					</div>
				</div>

				<p class="text-sm leading-6 text-muted-foreground/80">{aiFlexibilityNote}</p>

				<div class="flex flex-col gap-4 pe-4 pt-2 sm:flex-row">
					<Button href={docsUrl} size="lg" target="_blank" rel="noopener noreferrer" class="flex items-center">
						View documentation
						<ArrowRight class="ms-2 size-4" aria-hidden="true" />
					</Button>
				</div>
			</div>

			<Image3D
				lightSrc="/images/arkivra-chat-light.png"
				darkSrc="/images/arkivra-chat-dark.png"
				alt="Arkivra document chat and search workspace"
				direction="right"
				fit="contain"
				fade={false}
				class="order-1 lg:order-2"
			/>
		</div>
	</div>
</section>
