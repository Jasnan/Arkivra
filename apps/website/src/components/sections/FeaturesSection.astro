---
import Badge from "@/components/ui/Badge.astro";
import CardDecorator from "@/components/ui/CardDecorator.astro";
import { values } from "@/data/landing";
---

<section id="about" class="bg-muted/30 py-24 sm:py-32">
	<div class="container mx-auto px-4 sm:px-6 lg:px-8">
		<div class="mx-auto mb-16 max-w-4xl text-center">
			<Badge variant="outline" class="mb-4">About Arkivra</Badge>
			<h2 class="mb-6 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
				Designed for self-hosted environments.
			</h2>
			<p class="text-xl leading-8 text-muted-foreground text-pretty">
				Deploy Arkivra with Docker on infrastructure you manage. Configure vault access and storage for your deployment.
				Backups and optional integrations remain under operator control.
			</p>
		</div>

		<div class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 xl:grid-cols-3">
			{
				values.map((value) => {
					const Icon = value.icon;

					return (
						<div class="card shadow-xs">
							<div class="card-content p-6">
								<div class="flex flex-col items-center text-center">
									<CardDecorator>
										<Icon class="size-6" aria-hidden="true" />
									</CardDecorator>
									<h3 class="mt-4 text-xl font-medium text-balance">{value.title}</h3>
									<p class="mt-2 text-base leading-6 text-muted-foreground">{value.description}</p>
								</div>
							</div>
						</div>
					);
				})
			}
		</div>
	</div>
</section>
