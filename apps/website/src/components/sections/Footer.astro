---
import GitHubMark from "@/components/icons/GitHubMark.astro";
import Logo from "@/components/icons/Logo.astro";
import Button from "@/components/ui/Button.astro";
import { footerLinks, githubUrl } from "@/data/landing";
import { Heart, Mail, Rss } from "@lucide/astro";

const socialLinks = [
	{ name: "GitHub", href: githubUrl, icon: GitHubMark },
	{ name: "Email", href: "mailto:contact@arkivra.app", icon: Mail },
	{ name: "RSS", href: "/rss.xml", icon: Rss },
];

const year = new Date().getFullYear();
---

<footer class="border-t bg-background">
	<div class="container mx-auto px-4 py-16 sm:px-6 lg:px-8">
		<div class="grid grid-cols-4 gap-8 lg:grid-cols-6">
			<div class="col-span-4 max-w-2xl lg:col-span-3">
				<a href="#hero" class="js-scroll-link mb-4 flex items-center space-x-2 max-lg:justify-center">
					<Logo size={32} />
					<span class="text-xl font-bold">Arkivra</span>
				</a>
				<p class="mb-6 text-muted-foreground max-lg:text-center">
					Open-source document management system with powerful search and optional AI.
				</p>
				<div class="flex space-x-4 max-lg:justify-center">
					{
						socialLinks.map((social) => {
							const Icon = social.icon;
							const isExternal = social.href.startsWith("http");

							return (
								<Button
									href={social.href}
									variant="ghost"
									size="icon"
									target={isExternal ? "_blank" : undefined}
									rel={isExternal ? "noopener noreferrer" : undefined}
									ariaLabel={social.name}
								>
									<Icon class="size-4" />
								</Button>
							);
						})
					}
				</div>
			</div>

			<div class="max-md:col-span-2 lg:col-span-1">
				<h4 class="mb-4 font-semibold">Project</h4>
				<ul class="space-y-3">
					{
						footerLinks.project.map((link) => (
							<li>
								<a href={link.href} class="js-scroll-link text-muted-foreground transition-colors hover:text-foreground">
									{link.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="max-md:col-span-2 lg:col-span-1">
				<h4 class="mb-4 font-semibold">Resources</h4>
				<ul class="space-y-3">
					{
						footerLinks.resources.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-muted-foreground transition-colors hover:text-foreground"
									target={link.href.startsWith("http") ? "_blank" : undefined}
									rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
								>
									{link.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="max-md:col-span-2 lg:col-span-1">
				<h4 class="mb-4 font-semibold">Legal</h4>
				<ul class="space-y-3">
					{
						footerLinks.legal.map((link) => (
							<li>
								<a href={link.href} class="text-muted-foreground transition-colors hover:text-foreground">
									{link.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>

		<div class="my-8 h-px w-full bg-border"></div>

		<div class="flex flex-col items-center justify-between gap-2 text-sm text-muted-foreground lg:flex-row">
			<span class="flex flex-wrap items-center justify-center gap-1.5">
				Created and maintained
				<Heart class="size-4 fill-red-500 text-red-500" aria-label="love" />
				by
				<a
					href="https://jasnan.xyz/"
					target="_blank"
					rel="noopener noreferrer"
					class="font-medium text-foreground transition-colors hover:text-primary"
				>
					Jasnan Thachaparamban
				</a>
				.
			</span>
			<span>&copy; {year} Arkivra</span>
		</div>
	</div>
</footer>
