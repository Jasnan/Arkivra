---
import GitHubMark from "@/components/icons/GitHubMark.astro";
import Logo from "@/components/icons/Logo.astro";
import Button from "@/components/ui/Button.astro";
import {
	docsUrl,
	githubUrl,
	navigationItems,
	quickStartUrl,
} from "@/data/landing";
import { Archive, Menu, Moon, Sun, X } from "@lucide/astro";

type Props = {
	homeHref?: string;
	sectionHrefPrefix?: string;
};

const { homeHref = "#hero", sectionHrefPrefix = "" } = Astro.props;

const resolveNavigationHref = (href: string) =>
	href.startsWith("#") ? `${sectionHrefPrefix}${href}` : href;
---

<header class="sticky top-0 z-50 w-full border-b bg-background/80 backdrop-blur-xl supports-[backdrop-filter]:bg-background/60">
	<div class="container mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
		<a href={homeHref} class="js-scroll-link flex items-center space-x-2">
			<Logo size={32} />
			<span class="font-bold">Arkivra</span>
		</a>

		<nav class="hidden items-center xl:flex" aria-label="Main navigation">
			{
				navigationItems.map((item) => (
					<a
						href={resolveNavigationHref(item.href)}
						class="js-scroll-link inline-flex h-10 items-center justify-center px-4 py-2 text-sm font-medium transition-colors hover:text-primary focus:text-primary focus:outline-none"
					>
						{item.name}
					</a>
				))
			}
		</nav>

		<div class="hidden items-center space-x-2 xl:flex">
			<button type="button" class="button button-ghost button-icon theme-toggle" aria-label="Toggle theme">
				<Moon class="size-5 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" />
				<Sun class="absolute size-5 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" />
			</button>
			<Button href={githubUrl} variant="ghost" size="icon" target="_blank" rel="noopener noreferrer" ariaLabel="GitHub Repository">
				<GitHubMark class="size-5" />
			</Button>
			<Button href={docsUrl} variant="outline" target="_blank" rel="noopener noreferrer">Read the docs</Button>
			<Button href={quickStartUrl} target="_blank" rel="noopener noreferrer">
				<Archive class="mr-2 size-4" />
				Self-host
			</Button>
		</div>

		<button
			type="button"
			class="button button-ghost button-icon xl:hidden"
			data-drawer-open
			aria-label="Toggle menu"
			aria-controls="mobile-menu"
			aria-expanded="false"
		>
			<Menu class="size-5" />
		</button>
	</div>
</header>

<div class="mobile-drawer-backdrop fixed inset-0 z-50 bg-background/70 backdrop-blur-sm transition-opacity xl:hidden" data-drawer-backdrop>
</div>
<aside
	id="mobile-menu"
	class="mobile-drawer fixed inset-y-0 right-0 z-50 flex w-full flex-col overflow-hidden border-l bg-background shadow-2xl transition-transform duration-300 sm:w-[400px] xl:hidden"
	data-mobile-drawer
	aria-label="Mobile navigation"
>
	<div class="flex h-full flex-col">
		<div class="space-y-0 border-b p-4 pb-2">
			<div class="flex items-center gap-2">
				<div class="rounded-lg bg-primary/10 p-2">
					<Logo size={16} />
				</div>
				<h2 class="text-lg font-semibold">Arkivra</h2>
				<div class="ml-auto flex items-center gap-2">
					<button type="button" class="button button-ghost h-8 w-8 theme-toggle" aria-label="Toggle theme">
						<Moon class="size-4 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0" />
						<Sun class="absolute size-4 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100" />
					</button>
					<a
						href={githubUrl}
						class="button button-ghost h-8 w-8"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub Repository"
					>
						<GitHubMark class="size-4" />
					</a>
					<button type="button" class="button button-ghost h-8 w-8" data-drawer-close aria-label="Close menu">
						<X class="size-4" />
					</button>
				</div>
			</div>
		</div>

		<div class="flex-1 overflow-y-auto">
			<nav class="space-y-1 p-6" aria-label="Mobile navigation links">
				{
					navigationItems.map((item) => (
						<a
							href={resolveNavigationHref(item.href)}
							class="js-scroll-link flex items-center rounded-lg px-4 py-3 text-base font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
							data-drawer-close
						>
							{item.name}
						</a>
					))
				}
			</nav>
		</div>

		<div class="space-y-4 border-t p-6">
			<Button href={docsUrl} variant="outline" size="lg" class="w-full" target="_blank" rel="noopener noreferrer">
				Read the docs
			</Button>
			<Button href={quickStartUrl} size="lg" class="w-full" target="_blank" rel="noopener noreferrer">
				Self-host Arkivra
			</Button>
		</div>
	</div>
</aside>
