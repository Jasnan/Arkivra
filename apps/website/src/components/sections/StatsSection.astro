---
import DotPattern from "@/components/ui/DotPattern.astro";
import PillarPreview from "@/components/ui/PillarPreview.astro";
import { documentPillars } from "@/data/landing";
---

<section class="relative py-16 sm:py-24">
	<div class="absolute inset-0 bg-gradient-to-r from-primary/8 via-transparent to-secondary/20"></div>
	<DotPattern class="opacity-75" size="md" fade="circle" />

	<div class="container relative mx-auto px-4 sm:px-6 lg:px-8">
		<div class="mx-auto max-w-3xl text-center">
			<h2 class="text-3xl font-bold tracking-tight text-balance sm:text-4xl">More than a folder of files.</h2>
			<p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground text-pretty">
				Arkivra helps you structure what you store, search across it quickly, and use AI to work with the content
				inside.
			</p>
		</div>

		<div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
			{
				documentPillars.map((pillar) => (
					<div class="card overflow-hidden py-0 shadow-xs">
						<div class="card-content flex h-full flex-col p-0">
							<div class="relative flex h-52 items-center justify-center overflow-hidden border-b bg-background/50 p-6">
								<DotPattern class="opacity-75" size="sm" fade="ellipse" />
								<div class="relative flex h-full w-full items-center">
									<PillarPreview visual={pillar.visual} />
								</div>
							</div>
							<div class="flex flex-1 flex-col items-center p-6 text-center">
								<h3 class="text-xl font-medium text-balance">{pillar.title}</h3>
								<p class="mt-2 text-sm leading-6 text-muted-foreground">{pillar.description}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
