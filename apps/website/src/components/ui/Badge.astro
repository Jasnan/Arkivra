---
type Props = {
	variant?: "outline" | "secondary";
	class?: string;
};

const { variant = "outline", class: className = "" } = Astro.props;
const variantClass =
	variant === "secondary" ? "badge-secondary" : "badge-outline";
---

<span class:list={["badge", variantClass, className]}>
	<slot />
</span>
