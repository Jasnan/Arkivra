---
type Props = {
	href: string;
	variant?: "default" | "outline" | "ghost";
	size?: "default" | "lg" | "icon";
	class?: string;
	target?: string;
	rel?: string;
	ariaLabel?: string;
};

const {
	href,
	variant = "default",
	size = "default",
	class: className = "",
	target,
	rel,
	ariaLabel,
} = Astro.props;
const variantClass =
	variant === "outline"
		? "button-outline"
		: variant === "ghost"
			? "button-ghost"
			: "button-default";
const sizeClass =
	size === "lg"
		? "button-lg"
		: size === "icon"
			? "button-icon"
			: "h-9 px-4 py-2";
---

<a
	href={href}
	class:list={["button", variantClass, sizeClass, className]}
	target={target}
	rel={rel}
	aria-label={ariaLabel}
>
	<slot />
</a>
