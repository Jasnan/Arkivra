---
import Footer from "@/components/sections/Footer.astro";
import Header from "@/components/sections/Header.astro";
import DotPattern from "@/components/ui/DotPattern.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
	title?: string;
	description?: string;
	heading?: string;
	frontmatter?: {
		title?: string;
		description?: string;
		heading?: string;
	};
};

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "Arkivra";
const description = Astro.props.description ?? frontmatter.description ?? "";
const heading =
	Astro.props.heading ??
	frontmatter.heading ??
	title.replace(/\s+-\s+Arkivra$/, "");
---

<BaseLayout title={title} description={description}>
	<div class="min-h-screen bg-background">
		<Header homeHref="/" sectionHrefPrefix="/" />

		<main>
			<section class="relative overflow-hidden border-b py-20 sm:py-24">
				<div class="absolute inset-0">
					<DotPattern opacity="opacity-40" size="md" fade="ellipse" />
				</div>
				<div class="container relative mx-auto px-4 sm:px-6 lg:px-8">
					<div class="mx-auto max-w-3xl text-center">
						<h1 class="mb-6 text-4xl font-bold tracking-tight text-balance sm:text-6xl lg:text-7xl">{heading}</h1>
						<p class="mx-auto max-w-2xl text-lg text-muted-foreground text-pretty sm:text-xl">{description}</p>
					</div>
				</div>
			</section>

			<section class="py-16 sm:py-20">
				<div class="container mx-auto px-4 sm:px-6 lg:px-8">
					<article
						class="mx-auto max-w-3xl space-y-6 text-base leading-7 text-muted-foreground [&_a]:font-medium [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-4 [&_blockquote]:rounded-lg [&_blockquote]:border-l-4 [&_blockquote]:border-primary/40 [&_blockquote]:bg-muted/50 [&_blockquote]:px-5 [&_blockquote]:py-4 [&_blockquote]:text-sm [&_blockquote]:leading-6 [&_blockquote_p]:my-0 [&_code]:rounded [&_code]:bg-muted [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm [&_code]:text-foreground [&_h2]:pt-4 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-foreground [&_h3]:pt-3 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:tracking-tight [&_h3]:text-foreground [&_li]:pl-1 [&_ol]:ml-6 [&_ol]:list-decimal [&_strong]:font-semibold [&_strong]:text-foreground [&_ul]:ml-6 [&_ul]:list-disc"
					>
						<slot />
					</article>
				</div>
			</section>
		</main>

		<Footer homeHref="/" sectionHrefPrefix="/" />
	</div>
</BaseLayout>
