---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from './Layout.astro';
---

<Layout>
<div class="bg-background text-foreground">
  <Header />

  <div class="w-full border-b border-border bg-card pt-32 pb-24">
      <div class="max-w-700px mx-auto p-4">
        <h1 class="mb-3 font-display text-4xl font-semibold leading-tight">{Astro.props.frontmatter.title}</h1>
        <p class="mb-2 text-base leading-7 text-muted-foreground">{Astro.props.frontmatter.description}</p>

        {Astro.props.frontmatter.tags && (
          <div class="flex flex-wrap mt-2">
            {Astro.props.frontmatter.tags.map((tag: string) => (
              <span class="text-xs bg-card border px-2 py-1 mr-2 mb-2 font-medium">{tag}</span>
            ))}
          </div>
        )}
      </div>

    </div>

  <div class="px-6">
  <div class="prose mx-auto text-base pb-32">
      <slot />
  </div>
  </div>

  <Footer class="bg-background" />
</div>
</Layout>
