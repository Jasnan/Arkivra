---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from './Layout.astro';
---

<Layout>
<div class="bg-background text-foreground">
  <Header />

  <div class="w-full border-b border-border bg-card pt-28 pb-16 md:pt-34 md:pb-24">
      <div class="mx-auto max-w-760px px-5 md:px-8">
        <h1 class="font-display text-4xl font-semibold leading-tight md:text-6xl">{Astro.props.frontmatter.title}</h1>
        <p class="mt-5 max-w-700px text-base leading-7 text-muted-foreground md:text-xl md:leading-8">{Astro.props.frontmatter.description}</p>

        {Astro.props.frontmatter.tags && (
          <div class="flex flex-wrap mt-2">
            {Astro.props.frontmatter.tags.map((tag: string) => (
              <span class="text-xs bg-card border px-2 py-1 mr-2 mb-2 font-medium">{tag}</span>
            ))}
          </div>
        )}
      </div>

    </div>

  <div class="px-5 md:px-8">
  <div class="arkivra-prose mx-auto max-w-760px pb-32 pt-12 text-base">
      <slot />
  </div>
  </div>

  <Footer class="bg-background" />
</div>
</Layout>
