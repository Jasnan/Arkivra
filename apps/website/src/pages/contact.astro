---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { useI18n } from '../i18n/i18n';
import Layout from '../layouts/Layout.astro';
import { GITHUB_REPO_URL } from '../socials';

const { t } = useI18n();

const contactCards = [
  {
    title: t('contact.card.direct.title'),
    description: [t('contact.card.direct.description-1'), t('contact.card.direct.description-2')],
    icon: 'i-tabler-mail',
    iconClass: 'bg-emerald-500/10 text-emerald-700 ring-emerald-700/10 dark:bg-emerald-400/12 dark:text-emerald-300 dark:ring-emerald-300/15',
    accentClass: 'bg-emerald-700 dark:bg-emerald-300',
    buttonIconClass: 'text-emerald-700 dark:text-emerald-300',
    action: {
      icon: 'i-tabler-mail',
      label: 'contact@arkivra.app',
      url: 'mailto:contact@arkivra.app',
    },
  },
  {
    title: t('contact.card.involved.title'),
    description: [t('contact.card.involved.description-1'), t('contact.card.involved.description-2')],
    icon: 'i-tabler-brand-github',
    iconClass: 'bg-blue-500/10 text-blue-700 ring-blue-700/10 dark:bg-blue-400/12 dark:text-blue-300 dark:ring-blue-300/15',
    accentClass: 'bg-blue-600 dark:bg-blue-300',
    buttonIconClass: 'text-foreground',
    action: {
      icon: 'i-tabler-brand-github',
      label: t('contact.card.involved.button-label'),
      url: GITHUB_REPO_URL,
    },
  },
];
---

<Layout title="Contact" description="Contact Arkivra and follow project contribution channels.">
  <div class="min-h-screen bg-background text-foreground">
    <Header />

    <main class="mx-auto max-w-1200px px-5 pt-28 pb-16 md:px-8 md:pt-34 md:pb-24">
      <div class="max-w-760px">
        <div class="text-sm font-semibold uppercase tracking-wide text-primary">{t('contact.eyebrow')}</div>
        <h1 class="mt-4 font-display text-4xl font-semibold leading-tight md:text-6xl">{t('contact.title')}</h1>
        <p class="mt-5 max-w-700px text-base leading-7 text-muted-foreground md:text-xl md:leading-8">
          {t('contact.subtitle.line-1')}
          <br class="hidden sm:block" />
          {t('contact.subtitle.line-2')}
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-7 md:grid-cols-2">
        {
          contactCards.map(card => (
            <article class="grid min-h-330px gap-6 rounded-lg border border-border bg-card p-7 shadow-sm md:grid-cols-[88px_1fr] md:p-9">
              <div class={`flex size-18 items-center justify-center rounded-full ring-1 ${card.iconClass}`}>
                <div class={`${card.icon} size-8`} aria-hidden="true" />
              </div>

              <div class="flex flex-col">
                <h2 class="text-2xl font-semibold leading-tight">{card.title}</h2>
                <div class={`mt-6 h-0.75 w-14 ${card.accentClass}`} aria-hidden="true"></div>
                <p class="mt-10 max-w-390px text-base leading-7 text-muted-foreground">
                  {card.description[0]}
                  <br />
                  {card.description[1]}
                </p>

                <a
                  href={card.action.url}
                  class="mt-8 inline-flex w-fit items-center gap-2.5 rounded-sm border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground shadow-sm transition hover:bg-muted"
                >
                  <div class={`${card.action.icon} size-5 ${card.buttonIconClass}`} aria-hidden="true" />
                  {card.action.label}
                  {card.action.url === GITHUB_REPO_URL && <div class="i-tabler-external-link size-4 text-muted-foreground" aria-hidden="true" />}
                </a>
              </div>
            </article>
          ))
        }
      </div>

    </main>

    <Footer class="bg-background" />
  </div>
</Layout>
