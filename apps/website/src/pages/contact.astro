---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { useI18n } from '../i18n/i18n';
import Layout from '../layouts/Layout.astro';

const { t } = useI18n();

const generalCards = [
  {
    title: t('contact.general-inquiries.title'),
    description: t('contact.general-inquiries.description'),
    icon: 'i-tabler-mail',
    iconClass: 'bg-blue-500/10 text-blue-700 dark:bg-blue-400/12 dark:text-blue-300',
    actionClass: 'border-blue-600/25 text-blue-700 hover:bg-blue-500/8 dark:border-blue-300/35 dark:text-blue-300 dark:hover:bg-blue-400/10',
    button: {
      icon: 'i-tabler-mail',
      label: 'contact@arkivra.app',
      url: 'mailto:contact@arkivra.app',
    },
  },
  {
    title: t('contact.partnerships.title'),
    description: t('contact.partnerships.description'),
    icon: 'i-tabler-bulb',
    iconClass: 'bg-green-500/10 text-green-700 dark:bg-green-400/12 dark:text-green-300',
    actionClass: 'border-green-600/25 text-green-700 dark:border-green-300/35 dark:text-green-300',
    button: {
      icon: 'i-tabler-brand-github',
      label: t('contact.bug.button-label'),
      isAvailable: false,
    },
  },
  {
    title: t('contact.bug.title'),
    description: t('contact.bug.description'),
    icon: 'i-tabler-bug',
    iconClass: 'bg-orange-500/10 text-orange-700 dark:bg-orange-400/12 dark:text-orange-300',
    actionClass: 'border-orange-600/25 text-orange-700 dark:border-orange-300/35 dark:text-orange-300',
    button: {
      icon: 'i-tabler-brand-github',
      label: t('contact.bug.button-label'),
      isAvailable: false,
    },
  },
  {
    title: t('contact.community.title'),
    description: t('contact.community.description'),
    icon: 'i-tabler-users',
    iconClass: 'bg-violet-500/10 text-violet-700 dark:bg-violet-400/12 dark:text-violet-300',
    actionClass: 'border-violet-600/25 text-violet-700 dark:border-violet-300/35 dark:text-violet-300',
    button: {
      icon: 'i-tabler-brand-github',
      label: t('contact.community.button-label'),
      isAvailable: false,
    },
  },
];
---

<Layout title="Contact" description="Contact Arkivra and follow project contribution channels.">
  <div class="min-h-screen bg-background text-foreground">
    <Header />

    <main class="mx-auto max-w-1200px px-5 pt-28 pb-16 md:px-8 md:pt-34 md:pb-24">
      <div class="max-w-760px">
        <div class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">{t('contact.eyebrow')}</div>
        <h1 class="mt-4 font-display text-4xl font-semibold leading-tight md:text-6xl">{t('contact.title')}</h1>
        <p class="mt-5 max-w-660px text-base leading-7 text-muted-foreground md:text-xl md:leading-8">{t('contact.subtitle')}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-7 md:grid-cols-2">
        {
          generalCards.map(card => (
            <article class="grid gap-6 border border-border bg-card p-7 shadow-sm md:grid-cols-[96px_1fr] md:p-9">
              <div class={`flex size-20 items-center justify-center rounded-lg ${card.iconClass}`}>
                <div class={`${card.icon} size-10`} aria-hidden="true" />
              </div>

              <div>
                <h2 class="text-2xl font-semibold leading-tight">{card.title}</h2>
                <p class="mt-4 max-w-390px text-base leading-7 text-muted-foreground">{card.description}</p>
                {card.button && card.button.isAvailable !== false
                  ? (
                    <a
                      href={card.button.url}
                      class={`mt-8 inline-flex items-center gap-3 rounded-sm border bg-background px-4 py-3 text-base font-semibold transition ${card.actionClass}`}
                    >
                      <div class={`${card.button.icon} size-6`} aria-hidden="true" />
                      {card.button.label}
                    </a>
                    )
                  : card.button
                    ? (
                      <span class={`mt-8 inline-flex cursor-default items-center gap-3 rounded-sm border bg-background px-4 py-3 text-base font-semibold opacity-80 ${card.actionClass}`} aria-disabled="true">
                        <div class={`${card.button.icon} size-6`} aria-hidden="true" />
                        {card.button.label}
                      </span>
                      )
                    : null}
              </div>
            </article>
          ))
        }
      </div>

    </main>

    <Footer class="bg-background" />
  </div>
</Layout>
