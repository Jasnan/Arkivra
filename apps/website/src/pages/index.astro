---
import HeroSection from "@/components/home/HeroSection.astro";
import FAQ from "@/components/sections/FAQ.astro";
import Button from "@/components/ui/Button.astro";
import Layout from "@/layouts/Layout.astro";
import {
	Archive,
	ArrowRight,
	Bot,
	Brain,
	ClipboardList,
	FileText,
	Folder,
	FolderOpen,
	GitFork,
	History,
	Languages,
	Layers,
	LockKeyhole,
	MessageCircle,
	RotateCcw,
	Search,
	Server,
	SlidersHorizontal,
	Sparkles,
	Tag,
	Users,
} from "@lucide/astro";

// FAQ data
const faqItems = [
	{
		question: "Do I need AI to use Arkivra?",
		answer:
			"No. Arkivra works without AI. Upload documents, organize vaults, search content, manage versions, restore files, and create backups without connecting any AI provider.",
	},
	{
		question: "What does optional AI mean?",
		answer:
			"AI features are disabled by default. If you want AI-assisted features such as semantic search, chat, or translation, you can connect local models or supported cloud providers using your own configuration.",
	},
	{
		question: "Do my documents leave my computer?",
		answer:
			"Arkivra is self-hosted, so documents stay within the infrastructure you choose to run it on. Core document management and full-text search do not require any AI provider. If you configure remote AI providers, remote storage, or off-site backups, the content required for those features may be sent to those services according to your configuration.",
	},
	{
		question: "What happens when I use a remote AI provider?",
		answer:
			"Arkivra only sends the content required for the AI feature being used. Depending on configuration, this may include document text for indexing or document context for chat and other AI-assisted workflows.",
	},
	{
		question: "What is semantic search?",
		answer:
			"Regular search looks for matching words. Semantic search looks for matching meaning, so a search for car insurance may also find documents that mention vehicle coverage.",
	},
	{
		question: "Can Arkivra search scanned PDFs and documents?",
		answer:
			"Yes. Arkivra can extract searchable text from many scanned PDFs and images. Results depend on scan quality and the configured document processing pipeline.",
	},
	{
		question: "What license is Arkivra released under?",
		answer:
			"Arkivra is open source under the AGPL-3.0 license. The source code, issue tracker, and project roadmap are available on GitHub.",
	},
];

const coreDocumentFeatures = [
	{
		icon: Folder,
		title: "Vault organization",
		desc: "Create vaults to group documents the way that makes sense to you.",
		tone: "blue",
	},
	{
		icon: Tag,
		title: "Tags & metadata",
		desc: "Use tags, filters, and metadata to keep your documents structured and easy to find.",
		tone: "blue",
	},
	{
		icon: History,
		title: "Version history",
		desc: "Track document changes over time and restore any previous version with ease.",
		tone: "blue",
	},
	{
		icon: Users,
		title: "Access control",
		desc: "Manage vault members, roles, and permissions to keep document access controlled and collaborative.",
		tone: "blue",
	},
	{
		icon: Search,
		title: "Full-text search",
		desc: "Search the content of your documents, not just the file names.",
		tone: "blue",
	},
];

const optionalAiFeatures = [
	{
		icon: Brain,
		title: "Semantic search",
		desc: "Find relevant information by meaning, not just keywords.",
		tone: "purple",
	},
	{
		icon: MessageCircle,
		title: "Chat with documents",
		desc: "Ask questions and get answers from selected documents or entire vaults.",
		tone: "purple",
	},
	{
		icon: Languages,
		title: "Document translation",
		desc: "Translate documents into multiple languages to break down language barriers.",
		tone: "purple",
	},
];

const documentPillars = [
	{
		title: "Organize",
		description:
			"Keep every document in its place with vaults, folders, and tags that make sense to you.",
		icon: Layers,
		visual: "organize",
		points: [
			{ icon: Archive, text: "Organize at the top level with vaults" },
			{ icon: FolderOpen, text: "Structure your files with folders" },
			{ icon: Tag, text: "Tag documents your way" },
		],
	},
	{
		title: "Search",
		description:
			"Find what you need instantly with powerful search and smart filters.",
		icon: Search,
		visual: "search",
		points: [
			{ icon: FileText, text: "Full-text search across all documents" },
			{ icon: Search, text: "OCR for scanned and image files" },
			{ icon: SlidersHorizontal, text: "Filter by tags and metadata" },
		],
	},
	{
		title: "Understand",
		description:
			"Use AI to find answers, uncover insights, and translate content.",
		icon: Bot,
		visual: "understand",
		points: [
			{ icon: MessageCircle, text: "Ask questions about your documents" },
			{ icon: Brain, text: "Semantic search for deeper answers" },
			{ icon: Languages, text: "Translate and summarize content" },
		],
	},
];

const controlCards = [
	{
		icon: GitFork,
		title: "Open Source",
		desc: "AGPL-3.0 licensed and community driven. Transparent, auditable, and built for the long term.",
		tone: "blue",
	},
	{
		icon: Server,
		title: "Self-Hostable",
		desc: "Deploy with Docker and run Arkivra on your own servers or private infrastructure.",
		tone: "green",
	},
	{
		icon: Brain,
		title: "Use with or without AI",
		desc: "Arkivra works on its own. Enable AI for smarter search and answers, using local models or supported cloud providers.",
		tone: "purple",
	},
	{
		icon: LockKeyhole,
		title: "Document Encryption",
		desc: "Uploaded originals and stored extracted assets are encrypted by Arkivra. Database records follow your PostgreSQL deployment controls.",
		tone: "amber",
	},
	{
		icon: ClipboardList,
		title: "Audit & Activity",
		desc: "Track user activity, access events, and document changes with detailed audit logs.",
		tone: "blue",
	},
	{
		icon: RotateCcw,
		title: "Backups & Recovery",
		desc: "Back up your data regularly and restore when needed using your self-hosted deployment workflow.",
		tone: "green",
	},
];

const neutralIconFrame =
	"flex h-10 w-10 items-center justify-center rounded-lg bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300";
const optionalAiIconFrame =
	"flex h-10 w-10 items-center justify-center rounded-lg bg-violet-50 text-violet-600 dark:bg-violet-400/10 dark:text-violet-300";
const sectionIcon = "h-5 w-5";
---

<Layout
  title="Arkivra - Open-source document management"
  description="Arkivra is an open-source document management system for organizing files in vaults, searching their contents, and using optional provider-configured AI features when they fit your workflow."
  keywords="open-source document management, self-hosted documents, document search, vaults, optional AI"
>

  <!-- 1. Hero -->
  <HeroSection />

  <!-- 3. Organize / Search / Understand -->
  <section class="py-16 md:py-24 site-container">
    <div class="mx-auto max-w-4xl text-center">
      <h2 class="font-brand text-4xl leading-none text-primary dark:text-primary-light sm:text-5xl">
        More than a folder of files.
      </h2>
      <p class="mx-auto mt-5 max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-300 sm:text-base sm:leading-7 lg:text-lg lg:leading-8">
        Arkivra helps you structure what you store, search across it quickly, and use AI to work with the content inside.
      </p>
    </div>

    <div
      class="mt-12 overflow-hidden rounded-2xl border border-primary/10 bg-bg-secondary shadow-[0_18px_60px_rgba(25,34,47,0.08)] dark:border-neutral-700 dark:bg-bg-secondary-dark dark:shadow-[0_18px_60px_rgba(0,0,0,0.22)]"
      data-aos="fade-up-sm"
      data-aos-once="true"
    >
      <div class="grid grid-cols-1 divide-y divide-primary/10 lg:grid-cols-3 lg:divide-x lg:divide-y-0 dark:divide-neutral-700">
        {documentPillars.map((pillar) => (
          <article class="flex flex-col p-6 sm:p-7 lg:min-h-[500px]">
            <div class={neutralIconFrame}>
              <pillar.icon class={sectionIcon} stroke-width={1.8} />
            </div>
            <h3 class="mt-8 font-brand text-3xl leading-tight text-primary dark:text-primary-light">
              {pillar.title}
            </h3>
            <p class="mt-4 text-sm leading-7 text-neutral-600 dark:text-neutral-300">
              {pillar.description}
            </p>

            <div class="my-6 h-px w-full bg-neutral-200 dark:bg-neutral-700"></div>

            <ul class="space-y-4">
              {pillar.points.map((point) => (
                <li class="flex items-center gap-3 text-sm text-neutral-700 dark:text-neutral-300">
                  <point.icon class="h-4 w-4 flex-shrink-0 text-primary dark:text-primary-light" stroke-width={1.8} />
                  <span>{point.text}</span>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-8">
              {pillar.visual === "organize" && (
                <div class="rounded-xl border border-primary/10 bg-bg-primary/70 p-4 dark:border-neutral-700 dark:bg-neutral-900/40">
                  <div class="space-y-2 text-xs text-neutral-500 dark:text-neutral-400">
                    <div class="flex items-center gap-2 text-neutral-800 dark:text-neutral-100">
                      <span class="h-2 w-2 rounded-full bg-primary/60"></span>
                      My Vault
                    </div>
                    <div class="ml-5 flex items-center gap-2">
                      <FolderOpen class="h-3.5 w-3.5 text-primary" />
                      Projects
                    </div>
                    <div class="ml-10 flex items-center gap-2">
                      <FolderOpen class="h-3.5 w-3.5 text-primary" />
                      Design
                    </div>
                    <div class="ml-10 flex items-center gap-2">
                      <FolderOpen class="h-3.5 w-3.5 text-primary" />
                      Research
                    </div>
                  </div>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <span class="rounded-md bg-primary/10 px-2 py-1 text-xs text-primary">important</span>
                    <span class="rounded-md bg-emerald-100 px-2 py-1 text-xs text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300">2024</span>
                    <span class="rounded-md bg-accent/30 px-2 py-1 text-xs text-neutral-700 dark:text-neutral-200">client</span>
                  </div>
                </div>
              )}

              {pillar.visual === "search" && (
                <div class="rounded-xl border border-primary/10 bg-bg-primary/70 p-4 dark:border-neutral-700 dark:bg-neutral-900/40">
                  <div class="rounded-lg border border-primary/20 bg-white px-3 py-2 text-sm text-neutral-600 dark:border-primary-light/20 dark:bg-neutral-950 dark:text-neutral-300">
                    invoice from acme 2024
                  </div>
                  <div class="mt-4 flex items-center gap-3">
                    <span class="rounded-md border border-red-200 bg-red-50 px-2 py-2 text-xs font-semibold text-red-500 dark:border-red-900/70 dark:bg-red-950/30 dark:text-red-300">PDF</span>
                    <div class="min-w-0 flex-1 space-y-2">
                      <div class="h-2 w-4/5 rounded-full bg-neutral-200 dark:bg-neutral-700"></div>
                      <div class="h-2 w-2/3 rounded-full bg-neutral-200 dark:bg-neutral-700"></div>
                    </div>
                    <span class="rounded-md bg-primary/10 px-2 py-1 text-xs text-primary">acme</span>
                  </div>
                </div>
              )}

              {pillar.visual === "understand" && (
                <div class="rounded-xl border border-primary/10 bg-bg-primary/70 p-4 dark:border-neutral-700 dark:bg-neutral-900/40">
                  <div class="ml-auto w-fit rounded-lg bg-primary/10 px-3 py-2 text-xs text-primary dark:bg-primary-light/10 dark:text-primary-light">
                    What are the key terms in this contract?
                  </div>
                  <div class="mt-4 rounded-lg border border-primary/10 bg-white p-3 dark:border-neutral-700 dark:bg-neutral-950">
                    <div class="mb-2 flex items-center gap-2 text-primary dark:text-primary-light">
                      <Sparkles class="h-4 w-4" />
                      <span class="text-xs font-medium">AI summary</span>
                    </div>
                    <div class="space-y-2">
                      <div class="h-2 w-5/6 rounded-full bg-primary/20"></div>
                      <div class="h-2 w-3/4 rounded-full bg-primary/20"></div>
                      <div class="h-2 w-1/2 rounded-full bg-primary/20"></div>
                    </div>
                  </div>
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

  </section>

  <!-- 6. Features Grid -->
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,#fff7ed_0%,#fdfaf5_38%,#faf9f5_100%)] dark:bg-none dark:bg-bg-primary-dark"></div>
    <div class="site-container">
      <div class="mx-auto max-w-4xl text-center" data-aos="fade-up-sm" data-aos-once="true">
        <h2 class="font-brand text-4xl leading-tight text-primary dark:text-primary-light sm:text-5xl">
          Built for everyday document management.
        </h2>
        <p class="mx-auto mt-6 max-w-3xl text-sm leading-6 text-neutral-700 dark:text-neutral-300 sm:text-base sm:leading-7 lg:text-lg lg:leading-8">
          Practical tools for organizing documents, finding information, and working with knowledge stored across your vaults.
        </p>
      </div>

      <div
        class="mt-12 overflow-hidden rounded-lg border border-neutral-200/80 bg-white/90 shadow-[0_12px_34px_rgba(25,34,47,0.09)] dark:border-neutral-700 dark:bg-bg-secondary-dark/90 dark:shadow-[0_18px_42px_rgba(0,0,0,0.24)]"
        data-aos="fade-up-sm"
        data-aos-once="true"
      >
        <div class="grid grid-cols-1 divide-y divide-neutral-200/80 lg:grid-cols-5 lg:divide-x lg:divide-y-0 dark:divide-neutral-700">
          {coreDocumentFeatures.map((feature) => (
            <article class="flex flex-col p-6 lg:min-h-[270px]">
              <div class={neutralIconFrame}>
                <feature.icon class={sectionIcon} stroke-width={1.9} />
              </div>
              <h4 class="mt-6 text-lg font-semibold leading-snug text-primary dark:text-blue-300">{feature.title}</h4>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">{feature.desc}</p>
            </article>
          ))}
        </div>

        <div class="grid grid-cols-1 divide-y divide-neutral-200/80 border-t border-neutral-200/80 lg:grid-cols-3 lg:divide-x lg:divide-y-0 dark:divide-neutral-700 dark:border-neutral-700">
          {optionalAiFeatures.map((feature) => (
            <article class="flex flex-col p-6 lg:min-h-[285px]">
              <div class={optionalAiIconFrame}>
                <feature.icon class={sectionIcon} stroke-width={1.9} />
              </div>
              <h4 class="mt-6 text-lg font-semibold leading-snug text-violet-700 dark:text-violet-300">{feature.title}</h4>
              <p class="mt-3 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">{feature.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700 my-4 site-container"></div>

  <!-- 9. Control -->
  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,#fff7ed_0%,#fdfaf5_42%,#faf9f5_100%)] dark:bg-none dark:bg-bg-primary-dark"></div>
    <div class="site-container">
      <div class="mx-auto max-w-5xl text-center" data-aos="fade-up-sm" data-aos-once="true">
        <h2 class="font-brand text-4xl leading-tight text-primary dark:text-primary-light sm:text-5xl">
          Open source. Self-hostable.
        </h2>
        <p class="mx-auto mt-6 max-w-3xl text-sm leading-6 text-neutral-700 dark:text-neutral-300 sm:text-base sm:leading-7 lg:text-lg lg:leading-8">
          Deploy Arkivra wherever you want and decide how your documents and AI integrations are handled.
        </p>
      </div>

      <div
        class="mt-10 overflow-hidden rounded-lg border border-neutral-200/80 bg-white/90 shadow-[0_12px_34px_rgba(25,34,47,0.09)] dark:border-neutral-700 dark:bg-bg-secondary-dark/90 dark:shadow-[0_18px_42px_rgba(0,0,0,0.24)] lg:mt-14"
        data-aos="fade-up-sm"
        data-aos-once="true"
      >
        {[controlCards.slice(0, 3), controlCards.slice(3, 6)].map((row, rowIndex) => (
          <div
            class:list={[
              "grid grid-cols-1 divide-y divide-neutral-200/80 lg:grid-cols-3 lg:divide-x lg:divide-y-0 dark:divide-neutral-700",
              rowIndex > 0 && "border-t border-neutral-200/80 dark:border-neutral-700",
            ]}
          >
            {row.map((card) => (
              <article class="flex flex-col p-7 lg:min-h-[270px]">
                <div class={neutralIconFrame}>
                  <card.icon class={sectionIcon} stroke-width={1.9} />
                </div>
                <h3
                  class:list={[
                    "mt-6 text-lg font-semibold leading-snug",
                    card.tone === "blue" && "text-primary dark:text-blue-300",
                    card.tone === "green" && "text-emerald-700 dark:text-emerald-300",
                    card.tone === "purple" && "text-violet-700 dark:text-violet-300",
                    card.tone === "amber" && "text-amber-700 dark:text-amber-300",
                  ]}
                >
                  {card.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300">{card.desc}</p>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 11. FAQ -->
  <FAQ
    title="Frequently asked questions"
    description="Answers to the questions people usually ask before running Arkivra."
    items={faqItems}
  />

  <!-- 13. Final CTA -->
  <section class="py-12 md:py-20 site-container  rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10" data-aos="fade-up-xs" data-aos-once="true">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-brand mb-4" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="200" >Ready to organize your documents?</h2>
      <div class="flex flex-wrap justify-center gap-3" data-aos="fade-up-xs" data-aos-once="true" data-aos-delay="300">
        <Button url="https://docs.arkivra.app/self-hosting/using-docker-compose/" type="fill" className="text-lg px-8 py-3" target="_blank">
          Self-host Arkivra <ArrowRight size={18} />
        </Button>
      </div>
    </div>
  </section>

</Layout>
