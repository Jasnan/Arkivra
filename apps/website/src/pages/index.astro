---
import { Image } from 'astro:assets';
import HeroDark from '../assets/arkivra-vaults-hero-dark.png';
import HeroLight from '../assets/arkivra-vaults-hero-light.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { useI18n } from '../i18n/i18n';
import Layout from '../layouts/Layout.astro';

const { t } = useI18n();
const SELF_HOSTING_GUIDE_URL = 'https://docs.arkivra.app/self-hosting/using-docker-compose/';

const workflows = [
  {
    label: '01',
    title: 'Create vaults',
    description: 'Group related documents together in vaults such as Family, Finance, Work, Travel, or anything else that fits your life.',
  },
  {
    label: '02',
    title: 'Upload documents',
    description: 'Upload PDFs, scans, images, and other files. Arkivra extracts searchable text so information stays easy to find later.',
  },
  {
    label: '03',
    title: 'Search everything',
    description: 'Search across your documents by keywords, phrases, or content. Optional semantic search can help find related information even when the exact words don’t match.',
  },
  {
    label: '04',
    title: 'Ask with sources',
    description: 'When AI is enabled, ask questions about selected documents and get answers linked back to the original files.',
  },
];

const coreCapabilities = [
  {
    marker: '01',
    title: 'Organize your way',
    description: 'Use vaults, folders, tags, and metadata to create a structure that works for you.',
  },
  {
    marker: '02',
    title: 'Preview, version, restore',
    description: 'Preview files, track changes over time, restore previous versions, and recover documents from trash when needed.',
  },
  {
    marker: '03',
    title: 'Full-text search',
    description: 'Search across filenames and extracted document content without connecting any AI services.',
  },
  {
    marker: '04',
    title: 'Vault access',
    description: 'Give people access to specific vaults and control who can view, upload, manage, or use AI features within them.',
  },
];

const stack = [
  ['Application', 'React dashboard, Hono API, and PostgreSQL-backed workers.'],
  ['Data', 'PostgreSQL with Drizzle ORM, full-text indexes, and pgvector when semantic search is enabled.'],
  ['Parsing', 'Docling-backed document parsing and OCR pipelines for extracted text and assets.'],
  ['Integrations', 'Authentication, storage, backups, and optional AI adapters.'],
];

const securityNotes = [
  {
    title: 'Document storage',
    description: 'Uploaded files and stored extracted assets are encrypted at rest with configured keys.',
  },
  {
    title: 'Vault access',
    description: 'Permissions are managed at the vault level, keeping access control simple and predictable.',
  },
  {
    title: 'Authentication',
    description: 'Password sign-in, connected providers, and optional two-factor authentication.',
  },
  {
    title: 'Audit trail',
    description: 'Security and activity events provide visibility into user and system actions.',
  },
  {
    title: 'Backups & restore',
    description: 'Create encrypted backups of document storage and the database, then restore them when the required keys and secrets are available.',
  },
  {
    title: 'Optional AI integration',
    description: 'AI features remain disabled until configured. When external AI providers are used, only the document context needed for the request is sent to that provider.',
  },
];

const faqItems = [
  {
    question: 'Do I need AI to use Arkivra?',
    answer: 'No. Arkivra works without AI. Upload documents, organize vaults, search content, manage versions, restore files, and create backups without connecting any AI provider.',
  },
  {
    question: 'What happens when I use a remote AI provider?',
    answer: 'Arkivra only sends the content required for the AI feature being used. Depending on your configuration, this may include document text for indexing or document context for chat and other AI-assisted workflows. Local providers can keep this processing entirely within your own environment.',
  },
  {
    question: 'What is semantic search?',
    answer: 'Regular search looks for matching words. Semantic search looks for matching meaning. For example, a search for “car insurance” might also find documents that mention “vehicle coverage” even if the exact words differ.',
  },
  {
    question: 'Can Arkivra search scanned PDFs and documents?',
    answer: 'Yes. Arkivra can extract searchable text from many scanned PDFs and images, making them searchable like digital documents. Results depend on scan quality and the configured document processing pipeline.',
  },
  {
    question: 'What license is Arkivra released under?',
    answer: 'Arkivra is open source under the AGPL-3.0 license. The source code, issue tracker, and project roadmap are publicly available on GitHub.',
  },
];
---

<Layout
  rawTitle={t('site.title')}
  description={t('site.description')}
>
  <div class="min-h-screen bg-background">
    <Header />

    <section class="relative min-h-82vh overflow-hidden border-b border-border bg-background">
      <Image
        src={HeroLight}
        alt="Arkivra vault interface"
        class="absolute bottom-0 right-0 top-16 my-auto h-[calc(100%-4rem)] w-full object-contain object-right opacity-[0.18] md:w-[76%] 2xl:left-[calc((100%-1200px)/2+2rem)] 2xl:right-auto 2xl:object-left dark:hidden"
        loading="eager"
      />
      <Image
        src={HeroDark}
        alt="Arkivra vault interface"
        class="absolute bottom-0 right-0 top-16 my-auto hidden h-[calc(100%-4rem)] w-full object-contain object-right opacity-[0.16] md:w-[76%] 2xl:left-[calc((100%-1200px)/2+2rem)] 2xl:right-auto 2xl:object-left dark:block"
        loading="eager"
      />
      <div class="absolute inset-0 bg-[linear-gradient(90deg,hsl(var(--background))_0%,hsl(var(--background)/0.94)_38%,hsl(var(--background)/0.74)_68%,hsl(var(--background)/0.36)_100%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_bottom,hsl(var(--background)/0.42),transparent_34%,hsl(var(--background)/0.9))]"></div>

      <div class="relative z-10 mx-auto flex min-h-82vh max-w-1200px flex-col justify-center px-5 py-28 md:px-8 md:py-32">
        <div class="max-w-700px">
          <div class="mb-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
            <span>Open Source</span>
            <span aria-hidden="true">·</span>
            <span>Self-hostable</span>
            <span aria-hidden="true">·</span>
            <span>Optional AI</span>
          </div>

          <h1 class="max-w-660px font-display text-4xl font-semibold leading-tight text-balance md:text-6xl">
            Organize your documents.<br />
            Find what you need.
          </h1>

          <p class="mt-6 max-w-700px text-base leading-7 text-muted-foreground md:text-lg md:leading-8">
            An open-source home for your documents. Store them in organized vaults, search across everything, and add AI only if you want it.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={SELF_HOSTING_GUIDE_URL}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 border border-primary bg-primary/92 px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary/85"
            >
              Self-host Arkivra
              <span class="i-tabler-arrow-right size-5"></span>
            </a>
            <a
              href="https://github.com/Jasnan/Arkivra"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 border border-border bg-background/60 px-4 py-2.5 text-sm font-semibold text-foreground transition hover:border-foreground/30 hover:bg-muted"
            >
              <span class="i-tabler-brand-github size-5"></span>
              View on GitHub
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border bg-card py-18 md:py-24">
      <div class="mx-auto max-w-1200px px-5 md:px-8">
        <div class="grid gap-8 md:grid-cols-[0.75fr_1.25fr]">
          <div>
            <div class="text-sm font-semibold uppercase tracking-wide text-primary">Workflow</div>
            <h2 class="mt-4 font-display text-3xl font-semibold leading-tight md:text-5xl">Store once. Find later.</h2>
          </div>
          <p class="max-w-620px text-base leading-7 text-muted-foreground md:pt-10 md:text-lg">
            Whether it's passports, receipts, contracts, manuals, or project files, Arkivra helps you keep everything organized and searchable so you can find it when you need it.
          </p>
        </div>

        <div class="mt-14 grid grid-cols-1 md:grid-cols-4">
          {
            workflows.map((item, index) => (
              <article class={`group relative overflow-hidden border border-border bg-background p-6 transition-[border-color,box-shadow,transform] duration-200 ease-out hover:z-10 hover:border-primary/55 hover:shadow-sm motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025] ${index > 0 ? '-mt-px md:-ml-px md:mt-0' : ''}`}>
                <div class="absolute inset-x-0 top-0 h-1 bg-primary/0 transition-colors duration-200 group-hover:bg-primary/70"></div>
                <div class="flex items-center justify-between gap-4">
                  <span class="inline-flex size-9 items-center justify-center border border-border bg-card text-xs font-semibold text-muted-foreground transition-colors duration-200 group-hover:border-primary/35 group-hover:text-primary">{item.label}</span>
                </div>
                <h3 class="mt-7 text-xl font-semibold">{item.title}</h3>
                <p class="mt-4 text-base leading-7 text-muted-foreground">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="features" class="border-b border-border bg-background py-18 md:py-24">
      <div class="mx-auto grid max-w-1200px gap-10 px-5 md:grid-cols-[0.78fr_1.22fr] md:px-8">
        <div>
          <div class="text-sm font-semibold uppercase tracking-wide text-primary">Document Workflows</div>
          <h2 class="mt-4 max-w-540px font-display text-3xl font-semibold leading-tight md:text-5xl">Useful before AI.</h2>
          <p class="mt-6 max-w-520px text-base leading-7 text-muted-foreground md:text-lg">
            Good document management should not depend on AI. Arkivra helps you organize, search, recover, and control access to documents whether AI is enabled or not.
          </p>
        </div>

        <div class="relative bg-background">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,hsl(var(--foreground)/0.12)_1px,transparent_0)] bg-[size:24px_24px] opacity-[0.16] dark:opacity-[0.08]" aria-hidden="true"></div>

          <div class="relative grid grid-cols-1 sm:grid-cols-2">
            {
              coreCapabilities.map((item, index) => (
                <article class={`group relative min-h-220px border border-border bg-background p-6 transition-[border-color,box-shadow,transform] duration-200 ease-out hover:z-10 hover:border-primary/55 hover:shadow-sm motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025] md:p-8 ${index > 0 ? '-mt-px' : ''} ${index % 2 === 1 ? 'sm:-ml-px sm:mt-0' : ''} ${index > 1 ? 'sm:-mt-px' : ''}`}>
                  <div class="flex items-center gap-2 text-xs font-semibold leading-none text-muted-foreground transition-colors duration-200 group-hover:text-primary">
                    <span>{item.marker}</span>
                  </div>
                  <h3 class="mt-5 font-display text-xl font-semibold leading-tight">{item.title}</h3>
                  <p class="mt-4 max-w-300px text-base leading-7 text-muted-foreground">{item.description}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="architecture" class="border-b border-border bg-card py-18 md:py-24">
      <div class="mx-auto max-w-1200px px-5 md:px-8">
        <div class="grid gap-8 md:grid-cols-[0.8fr_1.2fr]">
          <div>
            <div class="text-sm font-semibold uppercase tracking-wide text-primary">Architecture</div>
            <h2 class="mt-4 font-display text-3xl font-semibold leading-tight md:text-5xl">A practical stack for self-hosting.</h2>
            <p class="mt-6 max-w-560px text-base leading-7 text-muted-foreground">
              Run Arkivra on infrastructure you control using familiar, self-hostable building blocks.
            </p>
          </div>

          <div class="border border-border bg-background/88 backdrop-blur-sm">
            {
              stack.map(([layer, value], index) => (
                <div class={`grid grid-cols-[120px_1fr] gap-4 p-6 ${index < stack.length - 1 ? 'border-b border-border' : ''}`}>
                  <div class="flex items-center gap-3 text-sm font-semibold text-muted-foreground">
                    <span class="h-6 w-1 bg-primary/45" aria-hidden="true"></span>
                    {layer}
                  </div>
                  <div class="text-base leading-7 text-foreground">{value}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="security" class="border-b border-border bg-background py-14 md:py-18">
      <div class="mx-auto grid max-w-1200px gap-8 px-5 md:grid-cols-[0.82fr_1.18fr] md:px-8">
        <div>
          <div class="text-sm font-semibold uppercase tracking-wide text-primary">Security & Privacy</div>
          <h2 class="mt-4 max-w-580px font-display text-3xl font-semibold leading-tight md:text-5xl">Clear about what is stored, processed, and shared.</h2>
          <p class="mt-5 max-w-560px text-base leading-7 text-muted-foreground md:text-lg md:leading-8">
            Security and privacy start with clarity. Arkivra makes it clear what stays local, what is encrypted, and what is shared when optional AI services are enabled.
          </p>

          <div class="mt-8 max-w-360px border border-border bg-background p-5 shadow-sm transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-primary/45 hover:shadow-md motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025]">
            <h3 class="text-lg font-semibold leading-tight text-primary">Important to know</h3>
            <p class="mt-3 text-base leading-7 text-foreground">
              Uploaded files and extracted assets are encrypted at rest. Search indexes, metadata, permissions, and other database content remain protected by your PostgreSQL deployment and infrastructure.
            </p>
          </div>
        </div>

        <div class="bg-background">
          {
            securityNotes.map((item, index) => (
              <article class={`group relative border border-border bg-background p-5 transition-[border-color,box-shadow,transform] duration-200 ease-out hover:z-10 hover:border-primary/55 hover:shadow-sm motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025] md:p-6 ${index > 0 ? '-mt-px' : ''}`}>
                <div class="grid gap-4 sm:grid-cols-[44px_1fr]">
                  <div class="text-sm font-semibold text-primary/80">{String(index + 1).padStart(2, '0')}</div>
                  <div>
                    <h3 class="text-xl font-semibold leading-tight">{item.title}</h3>
                    <p class="mt-2 max-w-620px text-base leading-7 text-muted-foreground">{item.description}</p>
                    {item.secondaryDescription && (
                      <p class="mt-3 max-w-620px text-base leading-7 text-muted-foreground">{item.secondaryDescription}</p>
                    )}
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-card py-18 md:py-24">
      <div class="mx-auto grid max-w-1200px gap-10 px-5 md:grid-cols-[0.78fr_1.22fr] md:px-8">
        <div>
          <div class="text-sm font-semibold uppercase tracking-wide text-primary">FAQ</div>
          <h2 class="mt-4 max-w-540px font-display text-3xl font-semibold leading-tight md:text-5xl">Frequently asked questions.</h2>
          <p class="mt-6 max-w-520px text-base leading-7 text-muted-foreground md:text-lg">
            Answers to the questions people usually ask before running Arkivra.
          </p>
        </div>

        <div class="space-y-3">
          {
            faqItems.map((item, index) => (
              <details class="group border border-border bg-background p-6 transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-primary/45 hover:shadow-sm motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025] md:p-7" open={index === 0}>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-5 [&::-webkit-details-marker]:hidden">
                  <h3 class="text-xl font-semibold">{item.question}</h3>
                  <span class="i-tabler-chevron-down size-5 flex-shrink-0 text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true"></span>
                </summary>
                <div class="mt-4 space-y-4 text-base leading-7 text-muted-foreground">
                  {(Array.isArray(item.answer) ? item.answer : [item.answer]).map(paragraph => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
