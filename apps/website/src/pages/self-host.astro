---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';

const docsLinks = [
  {
    title: 'Self-hosting guide',
    description: 'Use the documentation for the current Docker Compose path, service layout, and production notes.',
    href: 'https://docs.arkivra.app/self-hosting/using-docker-compose/',
  },
  {
    title: 'Configuration',
    description: 'Review environment variables for auth, storage, parsing, backups, AI providers, and deployment origins.',
    href: 'https://docs.arkivra.app/self-hosting/configuration/',
  },
  {
    title: 'Document encryption',
    description: 'Understand which stored files Arkivra encrypts and which PostgreSQL data your deployment must protect.',
    href: 'https://docs.arkivra.app/guides/document-encryption/',
  },
  {
    title: 'Backups and restore',
    description: 'Plan backup archives, restore keys, maintenance mode, and the secrets that must be preserved separately.',
    href: 'https://docs.arkivra.app/guides/backups-and-restore/',
  },
];

const boundaries = [
  {
    title: 'Documents first',
    description: 'Uploads, parsing, previews, versions, full-text search, trash, and restore workflows do not require an AI provider.',
  },
  {
    title: 'Operator controlled',
    description: 'You choose where Arkivra runs, how PostgreSQL and storage are protected, and which optional integrations are enabled.',
  },
  {
    title: 'AI is optional',
    description: 'When AI features are enabled, document context is sent to the provider configured by the deployment operator.',
  },
];
---

<Layout title="Self-host Arkivra" description="Self-host Arkivra and use the documentation for setup, configuration, encryption, backups, and provider boundaries.">
  <div class="min-h-screen bg-background">
    <Header />

    <section class="border-b border-border bg-card pt-34 pb-16">
      <div class="mx-auto max-w-1100px px-5 md:px-8">
        <div class="max-w-780px">
          <div class="text-sm font-semibold uppercase tracking-wide text-primary">Self-hosting</div>
          <h1 class="mt-4 font-display text-4xl font-semibold leading-tight md:text-6xl">Run Arkivra where your documents belong.</h1>
          <p class="mt-5 text-base leading-7 text-muted-foreground md:text-xl md:leading-8">
            Arkivra is open source and self-hostable. The website keeps the product overview short; setup commands, environment variables, backups, encryption details, and provider behavior live in the documentation.
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href="https://docs.arkivra.app/self-hosting/using-docker-compose/"
              class="inline-flex items-center justify-center gap-2 border border-primary bg-primary/92 px-4 py-2.5 text-sm font-semibold text-primary-foreground transition hover:bg-primary/85"
            >
              Read self-hosting docs
              <span class="i-tabler-arrow-right size-5"></span>
            </a>
            <a
              href="https://github.com/Jasnan/Arkivra"
              target="_blank"
              rel="noopener"
              class="inline-flex items-center justify-center gap-2 border border-border bg-background/60 px-4 py-2.5 text-sm font-semibold text-foreground transition hover:border-foreground/30 hover:bg-muted"
            >
              <span class="i-tabler-brand-github size-5"></span>
              View source
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-border py-16 md:py-24">
      <div class="mx-auto grid max-w-1100px gap-8 px-5 md:grid-cols-[0.82fr_1.18fr] md:px-8">
        <div>
          <h2 class="font-display text-2xl font-semibold leading-tight md:text-4xl">Use the docs for deployment details.</h2>
          <p class="mt-5 leading-7 text-muted-foreground">
            Self-hosting decisions affect security, backups, provider data exposure, and recovery. Keep those instructions in the documentation so they stay complete and versioned with the rest of the operational guidance.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          {
            docsLinks.map(link => (
              <a
                href={link.href}
                class="group border border-border bg-card p-6 transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-primary/45 hover:shadow-sm motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025]"
              >
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-lg font-semibold leading-tight">{link.title}</h3>
                  <span class="i-tabler-external-link mt-0.5 size-5 flex-shrink-0 text-muted-foreground transition group-hover:text-primary" aria-hidden="true"></span>
                </div>
                <p class="mt-4 leading-7 text-muted-foreground">{link.description}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-card py-16 md:py-24">
      <div class="mx-auto max-w-1100px px-5 md:px-8">
        <div class="max-w-680px">
          <div class="text-sm font-semibold uppercase tracking-wide text-primary">Boundaries</div>
          <h2 class="mt-4 font-display text-2xl font-semibold leading-tight md:text-4xl">Clear responsibilities for operators.</h2>
          <p class="mt-5 max-w-680px leading-7 text-muted-foreground">
            Arkivra gives you a practical document system to run yourself. The deployment operator remains responsible for infrastructure security, database protection, secrets, backups, and optional provider choices.
          </p>
        </div>

        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {
            boundaries.map(item => (
              <article class="border border-border bg-background p-6 transition-[border-color,box-shadow,transform] duration-200 ease-out hover:border-primary/45 hover:shadow-sm motion-safe:hover:-translate-y-0.5 dark:hover:bg-foreground/[0.025]">
                <h3 class="text-lg font-semibold">{item.title}</h3>
                <p class="mt-4 leading-7 text-muted-foreground">{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>
