# Arkivra public Compose environment
#
# Copy this file to .env beside compose.production.yaml. This is the basic
# configuration needed for an Arkivra deployment with bundled PostgreSQL and an
# external Docling Serve endpoint. See the configuration reference for advanced options.

# Compose and PostgreSQL defaults.
COMPOSE_PROJECT_NAME=arkivra
POSTGRES_DB_NAME=arkivra
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Browser-facing Arkivra origin and published host port.
# Use HTTPS behind a reverse proxy in production.
ARKIVRA_PUBLIC_URL=
ARKIVRA_PORT=3210

# Initial authentication behavior. Keep registration enabled until the first
# administrator account exists.
ARKIVRA_AUTH_REGISTRATION_ENABLED=true
ARKIVRA_AUTH_EMAIL_VERIFICATION_REQUIRED=false

# Required even when AI is disabled. This must be a Docling Serve HTTP API URL
# reachable from inside the Arkivra container.
ARKIVRA_DOCLING_URL=

# Optional service endpoints. Omit them when the integration is not used.
# ARKIVRA_GOTENBERG_URL=http://gotenberg:3000
# ARKIVRA_OLLAMA_HOST=http://ollama:11434

# Required secrets. Keep these stable and back them up separately from Arkivra data.
# Generate with: openssl rand -hex 48
ARKIVRA_AUTH_SECRET=
# Generate with: openssl rand -hex 32, then prefix the result with 1:
ARKIVRA_ENCRYPTION_KEYS=

# Deployment controls. The pinned beta and loopback bind are the defaults.
# ARKIVRA_IMAGE=ghcr.io/jasnan/arkivra:beta
# ARKIVRA_BIND_ADDRESS=127.0.0.1

# Arkivra files use the Docker-managed arkivra-data volume by default. To use
# an existing absolute host path instead, create it first and uncomment:
# ARKIVRA_DATA_DIR=/srv/arkivra/data
