{
  "name": "arkivra",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hostable document management system with full-text search and optional AI integrations.",
  "author": "Jasnan Thachaparamban (https://jasnan.xyz)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --dir apps/arkivra-server dev:web",
    "dev:api": "pnpm --dir apps/arkivra-server dev:web",
    "dev:worker": "pnpm --dir apps/arkivra-server dev:worker",
    "dev:all": "pnpm --dir apps/arkivra-server dev",
    "dev:web": "pnpm --dir apps/arkivra-client dev",
    "dev:docs": "pnpm --dir apps/arkivra-docs dev",
    "deploy:website": "wrangler deploy --config apps/website/wrangler.jsonc",
    "deploy:docs": "wrangler deploy --config apps/arkivra-docs/wrangler.jsonc",
    "build:web": "pnpm --dir apps/arkivra-client build",
    "build": "pnpm --dir apps/arkivra-server build && pnpm --dir apps/arkivra-client build && pnpm --dir apps/website build && pnpm --dir apps/arkivra-docs build",
    "commitmsg:check": "node scripts/validate-commit-message.mjs",
    "deps:audit": "pnpm audit --audit-level high",
    "deps:audit:prod": "pnpm audit --prod --audit-level high",
    "deps:outdated": "pnpm outdated --recursive",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --dir apps/arkivra-server lint && pnpm --dir apps/arkivra-client lint && pnpm --dir apps/website lint && pnpm --dir apps/arkivra-docs lint",
    "test": "pnpm run test:fast",
    "test:fast": "pnpm --dir apps/arkivra-server test:fast && pnpm --dir apps/arkivra-client test:fast && pnpm --dir apps/website test:fast && pnpm --dir apps/arkivra-docs test:fast",
    "test:all": "pnpm run test:fast && pnpm run test:e2e:all",
    "test:db": "pnpm --dir apps/arkivra-server test:db",
    "test:e2e:all": "pnpm --dir apps/arkivra-server test:e2e:all",
    "test:e2e:backups": "pnpm --dir apps/arkivra-server test:e2e:backups",
    "test:e2e:background-jobs": "pnpm --dir apps/arkivra-server test:e2e:background-jobs",
    "test:e2e:db": "pnpm --dir apps/arkivra-server test:e2e:db",
    "test:e2e:docling": "pnpm --dir apps/arkivra-server test:e2e:docling",
    "test:e2e:processing": "pnpm --dir apps/arkivra-server test:e2e:processing",
    "db:cleanup:e2e": "pnpm --dir apps/arkivra-server db:cleanup:e2e",
    "test:watch": "vitest watch",
    "typecheck": "pnpm --dir apps/arkivra-server typecheck && pnpm --dir apps/arkivra-client typecheck && pnpm --dir apps/website check && pnpm --dir apps/arkivra-docs check",
    "db:check": "pnpm --dir apps/arkivra-server db:check",
    "db:generate": "pnpm --dir apps/arkivra-server db:generate",
    "db:migrate": "pnpm --dir apps/arkivra-server db:migrate",
    "db:reset:dev": "bash scripts/reset-dev-data.sh",
    "db:studio": "pnpm --dir apps/arkivra-server db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "4.110.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "brace-expansion": "5.0.6",
      "minimatch@3.1.5>brace-expansion": "2.0.2",
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0",
      "yaml": "2.9.0"
    }
  }
}
